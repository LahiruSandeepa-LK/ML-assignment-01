# Byte-compiled / optimized
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# REAL dataset is never committed — download it into data/raw/ locally.
# The committed sample (synthetic) lives in data/sample/ and is NOT ignored.
data/raw/*
!data/raw/README.md

# Processed / generated data
data/processed/*
!data/processed/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Reports build artifacts (keep figures/)
reports/*.pdf
